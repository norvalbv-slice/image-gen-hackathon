# ComfyUI for Qwen-Image-2512 (Official FP8)
# Features: Multi-image generation, LLM Judge, Menu Templates
# Models downloaded on first run (~36GB total)
# Use with 100GB+ container disk on RunPod
# License: Apache 2.0 (fully permissive commercial use)

FROM pytorch/pytorch:2.4.0-cuda12.4-cudnn9-runtime

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV COMFYUI_PATH=/comfyui

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    wget \
    curl \
    libgl1-mesa-glx \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Clone ComfyUI (latest for Qwen native support)
RUN git clone https://github.com/comfyanonymous/ComfyUI.git ${COMFYUI_PATH}

WORKDIR ${COMFYUI_PATH}

# Install ComfyUI dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Install additional dependencies for handler
RUN pip install --no-cache-dir \
    runpod \
    requests \
    aiohttp \
    huggingface_hub \
    openai \
    anthropic

# Create model directories (matching ComfyUI's expected structure)
RUN mkdir -p ${COMFYUI_PATH}/models/diffusion_models \
    ${COMFYUI_PATH}/models/text_encoders \
    ${COMFYUI_PATH}/models/vae \
    ${COMFYUI_PATH}/output \
    ${COMFYUI_PATH}/input

# Copy handler, workflows, templates, scenes, and utility files
COPY handler_qwen.py /handler.py
COPY workflow.json /workflow.json
COPY workflow_img2img.json /workflow_img2img.json
COPY templates.json /templates.json
COPY scenes.json /scenes.json
COPY scene_extractor.py /scene_extractor.py

WORKDIR /

CMD ["python", "-u", "/handler.py"]
